+/// TF_INKLING2_PREFILL_TC_FUSED_Q=0: disable P2 fused activation quantization in the TC up epilogue.
+pub fn prefillTcFusedQ() bool {
+    const S = struct {
+        var v: ?bool = null;
+    };
+    if (S.v == null) {
+        S.v = if (std.c.getenv("TF_INKLING2_PREFILL_TC_FUSED_Q")) |e| e[0] != '0' else true;
+    }
+    return S.v.?;

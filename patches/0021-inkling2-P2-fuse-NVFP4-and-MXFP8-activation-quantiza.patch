+                                                 float cap0, float cap1, int skip,
+                                                 uint8_t* __restrict__ out_sc = nullptr) {
   static_assert((PWARPS / CW) * RT * 16 == 64, "a prompt item holds 64 pairs");
   __shared__ uint4 sw[PSTAGES][CW][M * MXB];
   __shared__ uint4 sx[PSTAGES][64][2];
@@ -587,8 +588,57 @@ __device__ __forceinline__ void prompt_body_tc_q(const uint8_t* __restrict__ xc,
     cp_wait<0>();
     if (live) {
 #pragma unroll
-      for (int r = 0; r < RT; ++r)
-        epilogue<EPI, M, RT>(acc, r, out, N, cb * COLS + 2 * t, pr0[r], pr1[r], v0[r], v1[r], cap0, cap1);
+      for (int r = 0; r < RT; ++r) {
+        if constexpr (QUANT_OUT && EPI == 4 && M == 2) {
+          const int kb = N >> 5;
+#pragma unroll
+          for (int h = 0; h < 2; ++h) {
+            const bool live_h = h ? v1[r] : v0[r];
+            const int row = h ? pr1[r] : pr0[r];
+            float vf[4][2];
+            float amax = 0.f;
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+              const float a0 = acc[0][r][j][2 * h], a1 = acc[0][r][j][2 * h + 1];
+              const float u0 = acc[1][r][j][2 * h], u1 = acc[1][r][j][2 * h + 1];
+              float o0, o1;
+              if (cap1 < 0.f) {
+                o0 = softcap_swiglu(bf(a0), bf(u0), cap0, -cap1);
+                o1 = softcap_swiglu(bf(a1), bf(u1), cap0, -cap1);
+              } else {
+                o0 = softcap_swiglu(a0, u0, cap0, cap1);
+                o1 = softcap_swiglu(a1, u1, cap0, cap1);
+              }
+              vf[j][0] = bf(o0);
+              vf[j][1] = bf(o1);
+              amax = fmaxf(amax, fmaxf(fabsf(vf[j][0]), fabsf(vf[j][1])));
+            }
+            amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, 1));
+            amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, 2));
+            uint32_t ue = 127u;
+            float inv = 1.f;
+            if (amax > 0.f) {
+              const uint32_t u = __float_as_uint(amax * (1.f / 448.f));
+              ue = ((u >> 23) & 0xFFu) + ((u & 0x7FFFFFu) != 0u ? 1u : 0u);
+              if (ue < 1u) ue = 1u;
+              if (ue > 254u) ue = 254u;
+              inv = __uint_as_float((254u - ue) << 23);
+            }
+            if (live_h) {
+              uint8_t* dst = reinterpret_cast<uint8_t*>(out) + static_cast<size_t>(row) * N + cb * 32;
+#pragma unroll
+              for (int j = 0; j < 4; ++j) {
+                const uint32_t b0 = __nv_cvt_float_to_fp8(vf[j][0] * inv, __NV_SATFINITE, __NV_E4M3);
+                const uint32_t b1 = __nv_cvt_float_to_fp8(vf[j][1] * inv, __NV_SATFINITE, __NV_E4M3);
+                *reinterpret_cast<uint16_t*>(dst + j * 8 + 2 * t) = static_cast<uint16_t>(b0 | (b1 << 8));
+              }
+              if (t == 0) out_sc[static_cast<size_t>(row) * kb + cb] = static_cast<uint8_t>(ue);
+            }
+          }
+        } else {
+          epilogue<EPI, M, RT>(acc, r, out, N, cb * COLS + 2 * t, pr0[r], pr1[r], v0[r], v1[r], cap0, cap1);
+        }
+      }
     }
   }
 }

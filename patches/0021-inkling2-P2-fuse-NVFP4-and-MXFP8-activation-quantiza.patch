+          const bool live_h = h ? v1 : v0;
+          const int row = h ? p1 : p0;
+          float vf[4][2];
+#pragma unroll
+          for (int j = 0; j < 4; ++j) {
+            const float a0 = acc[0][r][j][2 * h], a1 = acc[0][r][j][2 * h + 1];
+            const float u0 = acc[1][r][j][2 * h], u1 = acc[1][r][j][2 * h + 1];
+            float o0, o1;
+            if (limit2 < 0.f) {
+              o0 = softcap_swiglu(bf(a0), bf(u0), limit, -limit2);
+              o1 = softcap_swiglu(bf(a1), bf(u1), limit, -limit2);
+            } else {
+              o0 = softcap_swiglu(a0, u0, limit, limit2);
+              o1 = softcap_swiglu(a1, u1, limit, limit2);
+            }
+            vf[j][0] = bf(o0);
+            vf[j][1] = bf(o1);
+          }
+#pragma unroll
+          for (int b = 0; b < 2; ++b) {
+            const int j0 = 2 * b, j1 = 2 * b + 1;
+            float amax = fmaxf(fmaxf(fabsf(vf[j0][0]), fabsf(vf[j0][1])), fmaxf(fabsf(vf[j1][0]), fabsf(vf[j1][1])));
+            amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, 1));
+            amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, 2));
+            const nvfp4q::Scale sc = nvfp4q::block_scale(amax, 1.0f);
+            const uint32_t b0 = nvfp4q::e2m1(vf[j0][0] * sc.mul) | (nvfp4q::e2m1(vf[j0][1] * sc.mul) << 4);
+            const uint32_t b1 = nvfp4q::e2m1(vf[j1][0] * sc.mul) | (nvfp4q::e2m1(vf[j1][1] * sc.mul) << 4);
+            const uint32_t w0 = __shfl_sync(0xffffffffu, b0, gq * 4 + 0) |
+                                (__shfl_sync(0xffffffffu, b0, gq * 4 + 1) << 8) |
+                                (__shfl_sync(0xffffffffu, b0, gq * 4 + 2) << 16) |
+                                (__shfl_sync(0xffffffffu, b0, gq * 4 + 3) << 24);
+            const uint32_t w1 = __shfl_sync(0xffffffffu, b1, gq * 4 + 0) |
+                                (__shfl_sync(0xffffffffu, b1, gq * 4 + 1) << 8) |
+                                (__shfl_sync(0xffffffffu, b1, gq * 4 + 2) << 16) |
+                                (__shfl_sync(0xffffffffu, b1, gq * 4 + 3) << 24);
+            if (live_h && t == 0) {

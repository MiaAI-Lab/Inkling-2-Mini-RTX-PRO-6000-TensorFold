-      epilogue<EPI, M, TA>(acc, r, out, N, cb * COLS + 2 * t, p0, p1, v0, v1, limit, limit2);
+      if constexpr (QUANT_OUT && EPI == 4 && M == 2) {
+        const int kb = N >> 4;
+#pragma unroll

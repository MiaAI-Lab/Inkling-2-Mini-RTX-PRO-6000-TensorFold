From 7defca9c7d8e24b33551407167fbc3144731f35d Mon Sep 17 00:00:00 2001
From: MiaAI Lab <83042094+MiaAI-Lab@users.noreply.github.com>
Date: Fri, 27 Nov 2026 00:52:16 +0200
Subject: [PATCH] inkling2: P1 skip expired DFlash2 prompt ingest and unread
 last-visit prompt rows (TF_INKLING2_PROMPT_TRIM)

---
 zig/src/families/inkling2/kernels.zig      | 34 ++++++++
 zig/src/families/inkling2/mini_backend.zig | 19 +++++
 zig/src/families/inkling2/mini_dflash.zig  | 26 ++++++
 zig/src/families/inkling2/mini_model.zig   |  5 ++
 zig/src/families/inkling2/mini_native.zig  |  2 +
 zig/src/families/inkling2/mini_visit.zig   | 99 ++++++++++++++++++++--
 6 files changed, 179 insertions(+), 6 deletions(-)

diff --git a/zig/src/families/inkling2/kernels.zig b/zig/src/families/inkling2/kernels.zig
index 06c829e55..83fd50a4e 100644
--- a/zig/src/families/inkling2/kernels.zig
+++ b/zig/src/families/inkling2/kernels.zig
@@ -216,6 +216,40 @@ pub fn prep(k: *const Kernels, s: cuda.Stream, r: Rows, l: Layer, c: Prep, raw:
     try go(if (kv.fp8()) k.prep8 else k.prep, s, .{ .x = r.rows, .y = r.heads + 2 * r.kv_heads }, 32, &a);
 }
 
+/// K and V only (written to caches at pos % ring); skips Q and rel when last-visit outputs are unread.
+pub fn prepKvOnly(k: *const Kernels, s: cuda.Stream, r: Rows, l: Layer, c: Prep, k_raw: u64, v_raw: u64, kv: Cache) !void {
+    try headsFit(r);
+    var a: cuda.Args = .{};
+    for ([_]u64{ 0, k_raw, v_raw, 0, 0, 0, r.pos, r.seg_of, r.segs, 0, 0, kv.k, kv.v }) |v| a.add(v);
+    a.add(int(0));
+    a.add(int(r.kv_heads));
+    a.add(int(l.ring));
+    a.add(int(@intFromBool(l.tau)));
+    for ([_]f32{ c.qk_clip, c.rel_clip, c.floor, c.alpha, c.eps }) |v| a.add(v);
+    if (kv.fp8()) {
+        a.add(kv.ks);
+        a.add(kv.vs);
+    }
+    try go(if (kv.fp8()) k.prep8 else k.prep, s, .{ .x = r.rows, .y = 2 * r.kv_heads }, 32, &a);
+}
+
+/// Q and rel only (after prepKvOnly has already written the K/V caches).
+pub fn prepQOnly(k: *const Kernels, s: cuda.Stream, r: Rows, l: Layer, c: Prep, q_raw: u64, rel_raw: u64, scales: [2]u64, q: u64, rel: u64, kv: Cache) !void {
+    try headsFit(r);
+    var a: cuda.Args = .{};
+    for ([_]u64{ q_raw, 0, 0, rel_raw, scales[0], scales[1], r.pos, r.seg_of, r.segs, q, rel, 0, 0 }) |v| a.add(v);
+    a.add(int(r.heads));
+    a.add(int(r.kv_heads));
+    a.add(int(l.ring));
+    a.add(int(@intFromBool(l.tau)));
+    for ([_]f32{ c.qk_clip, c.rel_clip, c.floor, c.alpha, c.eps }) |v| a.add(v);
+    if (kv.fp8()) {
+        a.add(@as(u64, 0));
+        a.add(@as(u64, 0));
+    }
+    try go(if (kv.fp8()) k.prep8 else k.prep, s, .{ .x = r.rows, .y = r.heads }, 32, &a);
+}
+
 /// The bias table of each (row, head): its rel vector against the layer's rel_logits_proj [16][1024].
 pub fn relTable(k: *const Kernels, s: cuda.Stream, r: Rows, rel: u64, proj: u64, tab: u64) !void {
     var a: cuda.Args = .{};

@@ -130,6 +130,50 @@ fn proj(m: *const Model, k: *const Kernels, s: cuda.Stream, w: cuda.qmmf.Weight,
     try k.lane.matmulOut(s, x, w.k, n, w, out, .bf16, m.s.lane_part);
 }
 
+/// TF_INKLING2_ATTN_FP8_TC=1 (P3, lossy, default off): FP8 tensor-core attention projections for prompt rows.
+fn attnFp8TcOn() bool {
+    const S = struct {
+        var v: ?bool = null;
+    };
+    if (S.v == null) S.v = if (std.c.getenv("TF_INKLING2_ATTN_FP8_TC")) |e| e[0] == '1' else false;
+    return S.v.?;
+}
+
+fn quant8Row(k: *const Kernels, s: cuda.Stream, x: u64, n: usize, kcols: usize, out: u64, scales: u64) !void {
+    var a: cuda.Args = .{};
+    a.add(x);
+    a.add(@as(i32, @intCast(kcols)));
+    a.add(@as(i32, @intCast(n)));
+    a.add(@as(i32, @intCast(kcols)));
+    a.add(out);
+    a.add(scales);
+    try cuda.launch.launch(k.ck_quant8_row, .{ .grid = .{ .x = @intCast(n) }, .block = .{ .x = 256 } }, s, &a);
+}
+
+fn projTc(k: *const Kernels, s: cuda.Stream, w: cuda.qmmf.Weight, x8: u64, xsc: u64, out: u64, n: usize) !void {
+    const bm: usize = 128;
+    const bn: usize = 128;
+    const rows_t = (n + bm - 1) / bm;
+    const cols_t = (w.n + bn - 1) / bn;
+    const group = @max(1, @min(rows_t, (12 << 20) / (bm * w.k)));
+    var a: cuda.Args = .{};
+    a.add(x8);
+    a.add(w.codes);
+    a.add(w.scale);
+    a.add(xsc);
+    a.add(out);
+    for ([_]usize{ n, w.n, w.k, group }) |v| a.add(@as(i32, @intCast(v)));
+    try cuda.launch.launch(k.ck8_128_row, .{ .grid = .{ .x = @intCast(rows_t * cols_t) }, .block = .{ .x = 256 }, .shared = 65536 }, s, &a);
+}
+
+fn projPrompt(m: *const Model, k: *const Kernels, s: cuda.Stream, prompt: bool, w: cuda.qmmf.Weight, x: u64, out: u64, n: usize) !void {
+    if (prompt and w.mode == .fp8 and attnFp8TcOn() and n >= 64 and w.k % 64 == 0) {
+        try quant8Row(k, s, x, n, w.k, m.s.x_tc_codes, m.s.x_tc_scales);
+        return projTc(k, s, w, m.s.x_tc_codes, m.s.x_tc_scales, out, n);
+    }
+    return proj(m, k, s, w, x, out, n);
+}

 TF_CK8(tf_ck8_128c, 128, 128, 2, true, true)
 
+// P3: 128x128 unsplit-K FP8 tensor-core GEMM with per-row input scales and per-tensor weight scale.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_ck8_128_row(const uint8_t* __restrict__ x, const uint8_t* __restrict__ w, float w_scale,
+                   const float* __restrict__ row_scales, __nv_bfloat16* __restrict__ out, int M, int N, int K,
+                   int group) {
+    tf_ck::lane<tf_ck::Cfg<128, 128, 2, 4, true>, false, true>(x, w, w_scale, out, nullptr, M, N, K, 1, group,
+                                                               row_scales);
+}
+
+// P3: Per-row e4m3 quantization into fragment order (1 block of 256 threads per row).
+extern "C" __global__ void __launch_bounds__(256)
+    tf_ck_quant8_row(const __nv_bfloat16* __restrict__ x, int ldx, int M, int K, uint8_t* __restrict__ out,
+                     float* __restrict__ scales) {
+    __shared__ float sm[8];
+    const int row = blockIdx.x, tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    if (row >= M) return;
+    const __nv_bfloat16* src_row = x + static_cast<size_t>(row) * ldx;
+    float amax = 0.0f;
+    for (int i = tid * 8; i < K; i += 256 * 8) {
+        const uint4 v = *reinterpret_cast<const uint4*>(src_row + i);
+        float f[8];
+        tf_ck::unpack8(v, f);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) amax = fmaxf(amax, fabsf(f[j]));
+    }
+    for (int o = 16; o > 0; o >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, o));
+    if (lane == 0) sm[warp] = amax;
+    __syncthreads();
+    if (warp == 0) {
+        amax = lane < 8 ? sm[lane] : 0.0f;
+        for (int o = 4; o > 0; o >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, o));
+        if (lane == 0) {
+            const float sc = amax > 0.0f ? amax / 448.0f : 1.0f;
+            sm[0] = sc;
+            scales[row] = sc;
+        }
+    }
+    __syncthreads();
+    const float inv = 1.0f / sm[0];
+    const int groups = K / 16;
+    for (int grp = tid; grp < groups; grp += 256) {
+        const uint4* src = reinterpret_cast<const uint4*>(src_row + grp * 16);
+        float f[16];
+        tf_ck::unpack8(src[0], *reinterpret_cast<float(*)[8]>(f));
+        tf_ck::unpack8(src[1], *reinterpret_cast<float(*)[8]>(f + 8));
+        uint32_t w[4];
+#pragma unroll
+        for (int q = 0; q < 4; ++q) {
+            uint32_t packed = 0;
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                const int k = 2 * q + (j % 2) + 8 * (j / 2);
+                packed |= static_cast<uint32_t>(__nv_cvt_float_to_fp8(f[k] * inv, __NV_SATFINITE, __NV_E4M3)) << (8 * j);
+            }
+            w[q] = packed;
+        }
+        *reinterpret_cast<uint4*>(out + static_cast<size_t>(row) * K + grp * 16) = make_uint4(w[0], w[1], w[2], w[3]);
+    }
+}
+
 // The slices summed in slice order, one fp32 add a slice, then the factor and one bf16 rounding.
 extern "C" __global__ void __launch_bounds__(256)
     tf_ck8_reduce(const float* __restrict__ part, __nv_bfloat16* __restrict__ out, long long total, int SK, float alpha) {

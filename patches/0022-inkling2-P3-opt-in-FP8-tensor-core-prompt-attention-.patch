@@ -155,7 +155,8 @@ __device__ __forceinline__ void lane(const uint8_t* __restrict__ x, const uint8_
                         if (col + 1 < N) dst[1] = acc[i][j][2 * h + 1];
                         continue;
                     }
-                    put(row, col, acc[i][j][2 * h] * alpha, acc[i][j][2 * h + 1] * alpha);
+                    const float a = ROW_SCALE ? alpha * row_scales[row] : alpha;
+                    put(row, col, acc[i][j][2 * h] * a, acc[i][j][2 * h + 1] * a);

+            }
         }
-        const uint16_t* ks = smem + (it % kStages) * kStage;
+        const uint16_t* ks = ASYNC8 ? smem : smem + (it % kStages) * kStage;
         const uint16_t* vs = ks + kTile;
         if (busy && kt <= w_last) {  // a tile past all of a warp's rows is an exact no-op
             float sc[8][4];
@@ -273,7 +354,7 @@ __device__ __forceinline__ void promptTile(const uint16_t* __restrict__ q, const

 }
 
+// Pairwise native e4m3 -> bf16x2 -> fp32 * sc -> bf16x2: reproduces deq8 bit for bit on all finite e4m3 codes.
+__device__ __forceinline__ uint4 deq8_fast(uint2 c, float sc) {
+    uint32_t w[4];
+    const uint32_t in[2] = {c.x, c.y};
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const uint32_t word = in[i >> 1] >> ((i & 1) * 16);
+#if TF_FP_NATIVE
+        const uint32_t pair = tf_common::e4m3x2(word);
+#else
+        const uint32_t pair = tf_common::fp8pair(word);
+#endif
+        const float2 f = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&pair));
+        const __nv_bfloat162 r = __floats2bfloat162_rn(f.x * sc, f.y * sc);
+        w[i] = *reinterpret_cast<const uint32_t*>(&r);
+    }
+    return make_uint4(w[0], w[1], w[2], w[3]);
+}
+
 // The half offset of a tile's 16-byte piece `c` (dims 8c..8c+7) of key `key`: pieces XOR-swizzled by key & 7.
 __device__ __forceinline__ int piece(int key, int c) { return key * kDim + ((c ^ (key & 7)) << 3); }
 
+// P4a SMEM layout for async raw fp8 staging inside the 96 KiB dynamic smem:
+//   [0, 32 KiB): active bf16 K (16 KiB) + V (16 KiB) tiles
+//   [32 KiB, 80 KiB): 3 raw fp8 stages, each 16 KiB (8 KiB K + 8 KiB V)
+//   [80 KiB, 81.5 KiB): 3 scale stages, each 512 B (64 float K + 64 float V)
+constexpr int kRawTileBytes = kKeys * kDim;       // 8192 bytes
+constexpr int kRawStageBytes = 2 * kRawTileBytes; // 16384 bytes
+
+__device__ __forceinline__ void loadRaw8(uint16_t* smem, int st, const uint16_t* __restrict__ kc,
+                                         const uint16_t* __restrict__ vc, size_t head_base, int ring, int kt,
+                                         int k_lo, int k_hi, const float* __restrict__ ksc,
+                                         const float* __restrict__ vsc) {
+    uint8_t* raw = reinterpret_cast<uint8_t*>(smem + kStage) + st * kRawStageBytes;
+    uint8_t* rk = raw;
+    uint8_t* rv = raw + kRawTileBytes;
+    float* sc_buf = reinterpret_cast<float*>(reinterpret_cast<uint8_t*>(smem + kStage) + kStages * kRawStageBytes) + st * 2 * kKeys;
+    const size_t slot0 = static_cast<size_t>(kt % ring);
+    const uint8_t* k8 = reinterpret_cast<const uint8_t*>(kc);
+    const uint8_t* v8 = reinterpret_cast<const uint8_t*>(vc);
+    for (int e = threadIdx.x; e < kKeys * (kDim / 16); e += kThreads) {
+        const int key = e >> 3, col = (e & 7) * 16;
+        const int kp = kt + key;
+        const bool in = kp >= k_lo && kp <= k_hi;
+        const size_t at = in ? head_base + (slot0 + key) * kDim + col : head_base;
+        tf_common::cp16z(rk + key * kDim + col, k8 + at, in);
+        tf_common::cp16z(rv + key * kDim + col, v8 + at, in);
+    }
+    if (threadIdx.x < kKeys) {
+        const int key = threadIdx.x;
+        const int kp = kt + key;
+        const bool in = kp >= k_lo && kp <= k_hi;
+        const size_t sidx = (head_base + (slot0 + key) * kDim) / kDim;
+        sc_buf[key] = in ? ksc[sidx] : 0.0f;
+        sc_buf[kKeys + key] = in ? vsc[sidx] : 0.0f;
+    }
+    tf_common::cp_commit();
+}
+
+__device__ __forceinline__ void deqRaw8(uint16_t* smem, int st) {
+    uint16_t* ks = smem;
+    uint16_t* vs = smem + kTile;
+    const uint8_t* raw = reinterpret_cast<const uint8_t*>(smem + kStage) + st * kRawStageBytes;
+    const uint8_t* rk = raw;
+    const uint8_t* rv = raw + kRawTileBytes;
+    const float* sc_buf = reinterpret_cast<const float*>(reinterpret_cast<const uint8_t*>(smem + kStage) + kStages * kRawStageBytes) + st * 2 * kKeys;
+    for (int e = threadIdx.x; e < kKeys * (kDim / 8); e += kThreads) {
+        const int key = e >> 4, c = e & 15, col = c * 8;
+        const uint2 kc2 = *reinterpret_cast<const uint2*>(rk + key * kDim + col);
+        const uint2 vc2 = *reinterpret_cast<const uint2*>(rv + key * kDim + col);
+        *reinterpret_cast<uint4*>(ks + piece(key, c)) = deq8_fast(kc2, sc_buf[key]);
+        *reinterpret_cast<uint4*>(vs + piece(key, c)) = deq8_fast(vc2, sc_buf[kKeys + key]);
+    }
+}
+

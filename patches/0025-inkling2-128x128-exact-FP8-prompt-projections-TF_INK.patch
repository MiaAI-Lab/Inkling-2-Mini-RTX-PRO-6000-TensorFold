From 21bbce54d2d0f02e46c361fa27e3de9aaddd50bd Mon Sep 17 00:00:00 2001
From: MiaAI Lab <83042094+MiaAI-Lab@users.noreply.github.com>
Date: Fri, 27 Nov 2026 05:37:45 +0200
Subject: [PATCH] inkling2: 128x128 exact FP8 prompt projections
 (TF_INKLING2_PROMPT_FP8W_BF16_MMA)

Instantiate 128x128 8-warp 3-stage qmmf_kernel<FP8> using cp.async.bulk
and native e4m3x2 widening while preserving the exact BF16 MMA chain,
pinned K slices, and output rounding. Controlled by
TF_INKLING2_PROMPT_FP8W_BF16_MMA (default on).

Exactness: 6/6 ex.sh cells pass (30/30 rows identical to s3_base),
7/7 A-B-B-A token SHAs identical.
pre1 A-B-B-A: pre4k +2.36%, pre8k +2.59%, pre32k +2.54%, pre128k +2.01%.
---
 zig/kernels/cuda/qmmf.cu       | 12 ++++++++++-
 zig/kernels/cuda/qmmf_body.cuh | 12 ++++++++++-
 zig/src/cuda/qmmf.zig          | 39 ++++++++++++++++++++++++++++------
 3 files changed, 55 insertions(+), 8 deletions(-)

diff --git a/zig/kernels/cuda/qmmf.cu b/zig/kernels/cuda/qmmf.cu
index c08ad62af..97344b7cc 100644
--- a/zig/kernels/cuda/qmmf.cu
+++ b/zig/kernels/cuda/qmmf.cu
@@ -45,7 +45,7 @@ struct Tile {
     static constexpr int S = MODE == FP4 || MODE == FP8G ? BN * 4 : MODE == MXFP8 ? BN * 2 : 0;
     static constexpr int STAGE = (X + W + S + 127) / 128 * 128;
     static constexpr int PARTIALS = MT * NT * 4 * THREADS * 4;
-    static constexpr int BARRIERS = MODE == BF16 && BN > 64 ? 128 : 0;
+    static constexpr int BARRIERS = (MODE == BF16 || MODE == FP8) && BN > 64 ? 128 : 0;
     static constexpr int SMEM = (STAGES * STAGE > PARTIALS ? STAGES * STAGE : PARTIALS) + BARRIERS;
 };
 
@@ -214,6 +214,16 @@ BF16_PROMPT(true, false)
 BF16_PROMPT(true, true)
 #undef BF16_PROMPT
 
+#define FP8_PROMPT(F32, FUSE) \
+    template __global__ void qmmf_kernel<FP8, 128, 128, 2, 4, 3, F32, false, FUSE>( \
+        const __nv_bfloat16* __restrict__, const unsigned char* __restrict__, const uint8_t* __restrict__, float, \
+        void* __restrict__, float* __restrict__, int, int, int, int, int, int, int);
+FP8_PROMPT(false, false)
+FP8_PROMPT(false, true)
+FP8_PROMPT(true, false)
+FP8_PROMPT(true, true)
+#undef FP8_PROMPT
+
 // Unsplit K32 needs no inter-slice partial buffer or bulk-copy barrier storage.
 struct PromptK32Tile {
     static constexpr int THREADS = 256, MT = 4, NT = 4;
diff --git a/zig/kernels/cuda/qmmf_body.cuh b/zig/kernels/cuda/qmmf_body.cuh
index f3dc2ee6c..d19cd63bb 100644
--- a/zig/kernels/cuda/qmmf_body.cuh
+++ b/zig/kernels/cuda/qmmf_body.cuh
@@ -8,7 +8,7 @@
 #ifdef TF_QMMF_STRIDED
     static_assert(BN == 64 || BN == 32, "a block reads one 64-column tile of words and scales, or its half");
 #else
-    static_assert(BN == 64 || BN == 32 || (MODE == BF16 && BN == 128), "packed column tiles");
+    static_assert(BN == 64 || BN == 32 || ((MODE == BF16 || MODE == FP8) && BN == 128), "packed column tiles");
 #endif
     extern __shared__ __align__(128) unsigned char buf[];
     const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
@@ -217,8 +217,18 @@
                     b1 = v.y;
                 } else {
                     const uint32_t word = comp(wq[j], kt);
+#if TF_FP_NATIVE
+                    if constexpr (MODE == FP8 && BN == 128) {
+                        b0 = tf_common::e4m3x2(word);
+                        b1 = tf_common::e4m3x2(word >> 16);
+                    } else {
+                        b0 = fp8pair(word & 0xFFFFu);
+                        b1 = fp8pair(word >> 16);
+                    }
+#else
                     b0 = fp8pair(word & 0xFFFFu);
                     b1 = fp8pair(word >> 16);
+#endif
                 }
 #pragma unroll
                 for (int i = 0; i < T::MT; ++i) {
diff --git a/zig/src/cuda/qmmf.zig b/zig/src/cuda/qmmf.zig
index 5a5269ff9..67c45c08a 100644
--- a/zig/src/cuda/qmmf.zig
+++ b/zig/src/cuda/qmmf.zig
@@ -155,9 +155,21 @@ fn loadTiles(mod: Module, comptime mode: Mode, comptime wide: bool) ![7]Function
 
 /// BF16 prompt tile: 128x128, eight warps, three 32 KiB stages and one barrier per stage.
 pub const prompt_shared: u32 = 3 * (128 + 128) * group * 2 + 128;
+/// FP8 prompt tile: 128x128, eight warps, three 24 KiB stages (16 KiB X + 8 KiB W) and one barrier per stage.
+pub const prompt_fp8_shared: u32 = 3 * (128 * 2 + 128) * group + 128;
 pub const prompt_rows: usize = 512;
 pub const prompt_k32_shared: u32 = 3 * (128 + 128) * 32 * 2;
 
+fn promptFp8On() bool {
+    const S = struct {
+        var v: ?bool = null;
+    };
+    if (S.v == null) {
+        S.v = if (std.c.getenv("TF_INKLING2_PROMPT_FP8W_BF16_MMA")) |e| e[0] != '0' else true;
+    }
+    return S.v.?;
+}
+
 pub fn promptK32Symbol(comptime out: Out) [:0]const u8 {
     return std.fmt.comptimePrint("_ZN7tf_qmmf22qmmf_prompt_k32_kernelILb{d}EEEvPK13__nv_bfloat16PKhS5_fPvPfiiiiiii", .{@intFromBool(out == .f32)});
 }
@@ -171,9 +183,13 @@ pub fn promptSymbol(comptime out: Out, comptime fused: bool) [:0]const u8 {
     return std.fmt.comptimePrint("_ZN7tf_qmmf11qmmf_kernelILi4ELi128ELi128ELi2ELi4ELi3ELb{d}ELb0ELb{d}EEEvPK13__nv_bfloat16PKhS5_fPvPfiiiiiii", .{ @intFromBool(out == .f32), @intFromBool(fused) });
 }
 
-/// Only large BF16 grids use the prompt tile; the packed allocation contains complete 128-column tiles.
+pub fn promptFp8Symbol(comptime out: Out, comptime fused: bool) [:0]const u8 {
+    return std.fmt.comptimePrint("_ZN7tf_qmmf11qmmf_kernelILi1ELi128ELi128ELi2ELi4ELi3ELb{d}ELb0ELb{d}EEEvPK13__nv_bfloat16PKhS5_fPvPfiiiiiii", .{ @intFromBool(out == .f32), @intFromBool(fused) });
+}
+
+/// Only large BF16 or FP8 grids use the 128x128 prompt tile; the packed allocation contains complete 128-column tiles.
 pub fn promptEligible(m: usize, w: Weight) bool {
-    return m >= prompt_rows and w.mode == .bf16 and w.n >= 128 and
+    return m >= prompt_rows and (w.mode == .bf16 or (w.mode == .fp8 and promptFp8On())) and w.n >= 128 and
         (w.k >= 512 or (w.n == 10240 and w.k == 320)) and w.npad % 128 == 0;
 }
 
@@ -186,6 +202,7 @@ pub const Lane = struct {
     half_below: usize = half_below_default,
     shared_down: [4]Function = undefined,
     prompt: ?[2][2]Function = null, // Out, then plain / fused; loadPrompt() fills it on sm_12x
+    prompt_fp8: ?[2][2]Function = null, // Out, then plain / fused for FP8 weights; loadPrompt() fills it on sm_12x
     prompt_k32: ?[2]Function = null, // Out; unsplit BF16 prompt calls, loadPrompt() fills it on sm_12x
     prompt_sms: usize = 0, // the device's SMs: the tile runs when its blocks fill more than half of them
     clusters: bool, // sm_90 on: slices meet in a cluster's shared memory
@@ -230,6 +247,12 @@ pub const Lane = struct {
             try f.allowDynamicShared(prompt_shared);
             prompt[oi][fi] = f;
         };
+        var prompt_fp8: [2][2]Function = undefined;
+        inline for (.{ Out.bf16, Out.f32 }, 0..) |out, oi| inline for (.{ false, true }, 0..) |fused, fi| {
+            const f = try l.mod.function(promptFp8Symbol(out, fused));
+            try f.allowDynamicShared(prompt_fp8_shared);
+            prompt_fp8[oi][fi] = f;
+        };
         var k32: [2]Function = undefined;
         inline for (.{ Out.bf16, Out.f32 }, 0..) |out, oi| {
             const f = try l.mod.function(promptK32Symbol(out));
@@ -241,6 +264,7 @@ pub const Lane = struct {
         var sms: c_int = 0;
         try d.check(d.api.cuDeviceGetAttribute(&sms, .multiprocessor_count, dev), "cuDeviceGetAttribute");
         l.prompt = prompt;
+        l.prompt_fp8 = prompt_fp8;
         l.prompt_k32 = k32;
         l.prompt_sms = @intCast(@max(sms, 1));
     }
@@ -270,7 +294,8 @@ pub const Lane = struct {
     /// The actual prompt selection: loaded tiles, the pinned slice plan, and blocks over half the SMs.
     pub fn usesPrompt(l: Lane, m: usize, w: Weight) bool {
         const p = planFor(m, w, l.clusters);
-        return promptEligible(m, w) and !p.cluster and !p.reduce and l.prompt != null and
+        const loaded = if (w.mode == .fp8) l.prompt_fp8 != null else l.prompt != null;
+        return promptEligible(m, w) and !p.cluster and !p.reduce and loaded and
             2 * promptBlocks(m, w.n) > l.prompt_sms;
     }
 
@@ -281,12 +306,13 @@ pub const Lane = struct {
         const set = (if (out == .f32) l.f32_fns else l.fns)[modeIndex(w.mode)];
         const ti: usize = if (p.bm == 16) 0 else if (p.bm == 32) 1 else 2;
         const prompt = l.usesPrompt(m, w);
-        const k32 = prompt and p.sk == 1 and l.prompt_k32 != null;
+        const k32 = prompt and w.mode == .bf16 and p.sk == 1 and l.prompt_k32 != null;
         const bm: usize = if (prompt) 128 else p.bm;
         const rows_t = (m + bm - 1) / bm;
         const hm = halfModeIndex(w.mode);
         const half = hm != null and p.bm == 16 and !p.fused and rows_t * ((w.n + bn - 1) / bn) * p.sk < l.half_below;
-        const f = if (k32) l.prompt_k32.?[@backingInt(out)] else if (prompt) l.prompt.?[@backingInt(out)][@intFromBool(p.fused)] else if (half) l.half[hm.?][@backingInt(out)][@intFromBool(p.cluster)] else if (p.fused) set[6] else set[ti * 2 + @intFromBool(p.cluster)];
+        const pf = if (w.mode == .fp8) l.prompt_fp8.?[@backingInt(out)][@intFromBool(p.fused)] else l.prompt.?[@backingInt(out)][@intFromBool(p.fused)];
+        const f = if (k32) l.prompt_k32.?[@backingInt(out)] else if (prompt) pf else if (half) l.half[hm.?][@backingInt(out)][@intFromBool(p.cluster)] else if (p.fused) set[6] else set[ti * 2 + @intFromBool(p.cluster)];
         const cols: usize = if (prompt) 128 else if (half) 32 else bn;
         const band = @max(1, @min(rows_t, (12 << 20) / (bm * w.k * 2)));
         var args: launch_.Args = .{};
@@ -303,10 +329,11 @@ pub const Lane = struct {
         args.add(@as(i32, @intCast(w.npad)));
         args.add(@as(i32, @intCast(if (m == 1) w.k else ldx)));
         args.add(@as(i32, @intCast(band)));
+        const ps: u32 = if (w.mode == .fp8) prompt_fp8_shared else prompt_shared;
         try launch_.launch(f, .{
             .grid = .{ .x = @intCast(rows_t * ((w.n + cols - 1) / cols)), .y = 1, .z = if (p.fused) 1 else p.sk },
             .block = .{ .x = if (prompt) 256 else threads, .y = 1, .z = 1 },
-            .shared = if (k32) prompt_k32_shared else if (prompt) prompt_shared else if (half) halfShared(w.mode) else sharedBytes(w.mode, p.bm),
+            .shared = if (k32) prompt_k32_shared else if (prompt) ps else if (half) halfShared(w.mode) else sharedBytes(w.mode, p.bm),
             .cluster = if (p.cluster) .{ .x = 1, .y = 1, .z = p.sk } else null,
             .pdl = l.pdl and !prompt, // the prompt entries do not wait
         }, s, &args);

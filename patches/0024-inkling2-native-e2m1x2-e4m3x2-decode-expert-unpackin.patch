     for (int m = 0; m < M; ++m) {
       const float g = __ldg(scale + e * M + m);
@@ -238,8 +270,40 @@ template <int M>
 using Half = Stage<M, uint2>;
 
 // compute_stage's sums for tiles j = 2jh + jj: scale word 2h + jh, byte pair jj * 16.
-template <int M>
+template <int M, bool NATIVE = false>
 __device__ __forceinline__ void compute_half(float (&acc)[M][2][4], const Half<M>& st, bool hi, int jh) {
+#if TF_FP_NATIVE
+  if constexpr (NATIVE) {
+#pragma unroll
+    for (int m = 0; m < M; ++m)
+#pragma unroll
+      for (int jj = 0; jj < 2; ++jj) {
+        const uint32_t word = jj ? st.w[m].y : st.w[m].x;
+        const uint32_t lo = word & 0x0F0F0F0Fu, hi_n = (word >> 4) & 0x0F0F0F0Fu;
+        const uint32_t x = lo | (lo >> 12), y = hi_n | (hi_n >> 12);
+        const int sh = jj * 16;
+        float(&a)[4] = acc[m][jj];
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+          const uint32_t b0 = tf_common::e2m1x2(h ? x >> 8 : x);
+          const uint32_t b1 = tf_common::e2m1x2(h ? y >> 8 : y);
+          float p[4] = {0.f, 0.f, 0.f, 0.f};
+          mma(p, st.xa[h].x, st.xb[h].x, st.xa[h].y, st.xb[h].y, b0, b1);
+          const uint32_t sw = h == 0 ? (jh ? st.s[m].y : st.s[m].x) : (jh ? st.s[m].w : st.s[m].z);
+          const uint32_t sp = tf_common::e4m3x2(sw >> sh);
+          const float s0 = __uint_as_float((sp & 0xFFFFu) << 16);
+          const float s1 = __uint_as_float(sp & 0xFFFF0000u);
+          a[0] = fmaf(p[0], s0, a[0]);
+          a[1] = fmaf(p[1], s1, a[1]);
+          if (hi) {
+            a[2] = fmaf(p[2], s0, a[2]);
+            a[3] = fmaf(p[3], s1, a[3]);
+          }
+        }
+      }
+    return;
+  }
+#endif
 #pragma unroll
   for (int m = 0; m < M; ++m)
 #pragma unroll
@@ -306,7 +370,7 @@ __device__ __forceinline__ void epilogue_half(const float (&acc)[M][2][4], void*
 }
 
 // The decode form with two warps a unit (16 columns each): the same sums, twice the warps for few items.

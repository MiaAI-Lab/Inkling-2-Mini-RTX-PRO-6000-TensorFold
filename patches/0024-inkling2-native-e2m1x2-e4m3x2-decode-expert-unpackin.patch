 #pragma unroll
       for (int m = 0; m < M; ++m) {
         const float g = __ldg(scale + e * M + m);
@@ -928,3 +992,45 @@ extern "C" __global__ void __launch_bounds__(128)
   tf_nvfp4_experts::half_body<1, 0, 4>(X, x_stride, slots, W, scale, KG, NB, items, counts, members, out, N, limit,

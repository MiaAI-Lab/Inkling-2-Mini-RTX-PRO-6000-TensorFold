@@ -25,8 +25,40 @@ struct Stage {
   uint2 xa[2], xb[2];
 };
 
-template <int M>
+template <int M, bool NATIVE = false>
 __device__ __forceinline__ void compute_stage(float (&acc)[M][1][NTW][4], const Stage<M>& st, bool hi) {
+#if TF_FP_NATIVE
+  if constexpr (NATIVE) {
+#pragma unroll
+    for (int m = 0; m < M; ++m)
+#pragma unroll
+      for (int j = 0; j < NTW; ++j) {
+        const uint32_t word = comp(st.w[m], j);
+        const uint32_t lo = word & 0x0F0F0F0Fu, hi_n = (word >> 4) & 0x0F0F0F0Fu;
+        const uint32_t x = lo | (lo >> 12), y = hi_n | (hi_n >> 12);
+        const int sh = (j & 1) * 16;
+        float(&a)[4] = acc[m][0][j];
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+          const uint32_t b0 = tf_common::e2m1x2(h ? x >> 8 : x);
+          const uint32_t b1 = tf_common::e2m1x2(h ? y >> 8 : y);
+          float p[4] = {0.f, 0.f, 0.f, 0.f};
+          mma(p, st.xa[h].x, st.xb[h].x, st.xa[h].y, st.xb[h].y, b0, b1);
+          const uint32_t sw = comp(st.s[m], 2 * h + (j >> 1));
+          const uint32_t sp = tf_common::e4m3x2(sw >> sh);
+          const float s0 = __uint_as_float((sp & 0xFFFFu) << 16);
+          const float s1 = __uint_as_float(sp & 0xFFFF0000u);
+          a[0] = fmaf(p[0], s0, a[0]);
+          a[1] = fmaf(p[1], s1, a[1]);
+          if (hi) {
+            a[2] = fmaf(p[2], s0, a[2]);
+            a[3] = fmaf(p[3], s1, a[3]);
+          }
+        }
+      }
+    return;
+  }
+#endif
 #pragma unroll
   for (int m = 0; m < M; ++m)
 #pragma unroll
@@ -165,7 +197,7 @@ struct Ring {
 #endif
 
 // One unit of the decode form: a warp's 32 columns of item `unit / NB` over all K, then the epilogue.

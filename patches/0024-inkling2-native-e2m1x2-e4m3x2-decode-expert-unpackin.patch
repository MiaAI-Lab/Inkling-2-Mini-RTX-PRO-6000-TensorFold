+/// TF_INKLING2_EXPERT_NATIVE_UNPACK=0: disable native e2m1x2/e4m3x2 pair unpacking in decode experts.
+pub fn expertNativeUnpack() bool {
+    const S = struct {
+        var v: ?bool = null;
+    };
+    if (S.v == null) {
+        S.v = if (std.c.getenv("TF_INKLING2_EXPERT_NATIVE_UNPACK")) |e| e[0] != '0' else true;
+    }
+    return S.v.?;
+}
+
 /// nvfp4_experts.cu's soft-capped SwiGLU gate-up: decode units of 4 warps, and the prompt tiles of 4 warps.
 pub const Softcap = struct {
     fns: [4]Function = undefined, // decode, prompt, prompt_tc_q, prompt_tc_qq
@@ -104,7 +115,10 @@ pub const Softcap = struct {
 
     pub fn resolve(mod: Module, sms: usize) !Softcap {

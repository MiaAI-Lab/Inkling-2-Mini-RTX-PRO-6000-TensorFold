+fn projTcSplit(k: *const Kernels, s: cuda.Stream, w: cuda.qmmf.Weight, x8: u64, xsc: u64, n: usize, sc: ops.SplitCols) !void {
+    const bm: usize = 128;
+    const bn: usize = 128;
+    const rows_t = (n + bm - 1) / bm;
+    const cols_t = (w.n + bn - 1) / bn;
+    const group = @max(1, @min(rows_t, (12 << 20) / (bm * w.k)));
+    var a: cuda.Args = .{};
+    a.add(x8);
+    a.add(w.codes);
+    a.add(w.scale);
+    a.add(xsc);
+    for ([_]usize{ n, w.n, w.k, group }) |v| a.add(@as(i32, @intCast(v)));
+    a.add(sc);
+    try cuda.launch.launch(k.ck8_128_row_split, .{ .grid = .{ .x = @intCast(rows_t * cols_t) }, .block = .{ .x = 256 }, .shared = 65536 }, s, &a);
+}

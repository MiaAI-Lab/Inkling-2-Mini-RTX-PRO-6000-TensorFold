     vo[threadIdx.x + 64] = row[KVW + kh * HD + threadIdx.x + 64];
 }
 
+// Batched context K/V scatter (D2.1): row r -> ring_of[r] at slot (pos_of[r] % WIN) of `layer`.
+// grid (N, KVH), 64 threads.
+extern "C" __global__ void __launch_bounds__(64) tf_ink2d_ctx_kv_batch(const __nv_bfloat16* __restrict__ kv, const __nv_bfloat16* __restrict__ kn,
+                                                                       const long long* __restrict__ pos_of, const uint64_t* __restrict__ ring_of,
+                                                                       int layer, float eps, float theta) {
+    __shared__ float red[2];
+    const int r = blockIdx.x, kh = blockIdx.y;
+    const long long p = pos_of[r];
+    const uint64_t ring = ring_of[r];
+    const int slot = (int)(p % WIN);
+    const __nv_bfloat16* row = kv + (long long)r * 2 * KVW;
+    normRope(row + kh * HD, kn, eps, p, theta, ringK(ring, layer) + (long long)slot * KVW + kh * HD, red);
+    __nv_bfloat16* vo = ringV(ring, layer) + (long long)slot * KVW + kh * HD;
+    vo[threadIdx.x] = row[KVW + kh * HD + threadIdx.x];
+    vo[threadIdx.x + 64] = row[KVW + kh * HD + threadIdx.x + 64];
+}
+
 // Each block's 8 rows attend (non-causally) to their ring's window (max(from, p - 2047) .. start - 1) and all 8 block
 // keys, split over CH key chunks (running max, sum, fp32 output), merged by tf_ink2d_attn_merge.
 // grid (S, KVH, CH), 256 threads: a warp a block row, its 4 query heads of this key head.
@@ -198,6 +215,90 @@ extern "C" __global__ void __launch_bounds__(256) tf_ink2d_attn_part(const __nv_
     }
 }
 
+// D2.4: Shared-tile ring attention: all 8 warps cooperatively stage 16 K/V rows in shared memory (1x global load
+// instead of 8x), covering the widest window (row 0's lo) and masking positions before each row's own lo_j.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2d_attn_part_sh(const __nv_bfloat16* __restrict__ q, const __nv_bfloat16* __restrict__ kb,
+        const __nv_bfloat16* __restrict__ vb, const uint64_t* __restrict__ rings, const long long* __restrict__ starts,
+        const long long* __restrict__ froms, int layer, float scale, float* __restrict__ pm, float* __restrict__ pl,
+        float* __restrict__ pacc) {
+    constexpr int TK = 16;
+    __shared__ __nv_bfloat16 sm_k[TK][HD];
+    __shared__ __nv_bfloat16 sm_v[TK][HD];
+    const int s = blockIdx.x, kh = blockIdx.y, c = blockIdx.z;
+    const int tid = threadIdx.x, j = tid >> 5, lane = tid & 31;
+    const int r = s * BLOCK + j;
+    const long long start = starts[s], from = froms[s];
+    long long lo0 = start - (WIN - 1);
+    if (lo0 < from) lo0 = from;
+    if (lo0 < 0) lo0 = 0;
+    long long lo_j = (start + j) - (WIN - 1);
+    if (lo_j < from) lo_j = from;
+    if (lo_j < 0) lo_j = 0;
+    const long long n_ctx = start > lo0 ? start - lo0 : 0;
+    const long long T = n_ctx + BLOCK, L = (T + CH - 1) / CH;
+    const long long n0 = (long long)c * L, n1 = n0 + L < T ? n0 + L : T;
+    float qv[4][4], m[4], l[4], acc[4][4];
+    for (int h = 0; h < 4; ++h) {
+        const __nv_bfloat16* qh = q + (long long)r * QH * HD + (kh * 4 + h) * HD + lane * 4;
+        for (int i = 0; i < 4; ++i) qv[h][i] = bf(qh[i]) * scale;
+        m[h] = -INFINITY;
+        l[h] = 0.f;
+        for (int i = 0; i < 4; ++i) acc[h][i] = 0.f;
+    }
+    const __nv_bfloat16* K = ringK(rings[s], layer);
+    const __nv_bfloat16* V = ringV(rings[s], layer);
+    // 256 threads load 16 rows x 128 bf16 = 2048 bf16 = 256 x 8 bf16 (one uint4 per thread per K/V)
+    const int load_row = tid >> 4;        // 0..15
+    const int load_col = (tid & 15) * 8;  // 0, 8, ..., 120
+    for (long long base = n0; base < n1; base += TK) {
+        const long long n = base + load_row;
+        if (n < n1) {
+            const __nv_bfloat16 *kr, *vr;
+            if (n < n_ctx) {
+                const int slot = (int)((lo0 + n) % WIN);
+                kr = K + (long long)slot * KVW + kh * HD + load_col;
+                vr = V + (long long)slot * KVW + kh * HD + load_col;
+            } else {
+                const long long rb = (long long)s * BLOCK + (n - n_ctx);
+                kr = kb + rb * KVW + kh * HD + load_col;
+                vr = vb + rb * KVW + kh * HD + load_col;
+            }
+            *reinterpret_cast<uint4*>(&sm_k[load_row][load_col]) = *reinterpret_cast<const uint4*>(kr);
+            *reinterpret_cast<uint4*>(&sm_v[load_row][load_col]) = *reinterpret_cast<const uint4*>(vr);
+        }
+        __syncthreads();
+        const int lim = (int)(n1 - base < TK ? n1 - base : TK);
+        for (int tk = 0; tk < lim; ++tk) {
+            const long long nn = base + tk;
+            if (nn < n_ctx && (lo0 + nn) < lo_j) continue;
+            float kf[4], vf[4];
+            for (int i = 0; i < 4; ++i) {
+                kf[i] = bf(sm_k[tk][lane * 4 + i]);
+                vf[i] = bf(sm_v[tk][lane * 4 + i]);
+            }
+            for (int h = 0; h < 4; ++h) {
+                float d = qv[h][0] * kf[0] + qv[h][1] * kf[1] + qv[h][2] * kf[2] + qv[h][3] * kf[3];
+                for (int off = 16; off > 0; off >>= 1) d += __shfl_xor_sync(0xffffffffu, d, off);
+                const float mn = fmaxf(m[h], d);
+                const float corr = __expf(m[h] - mn), pe = __expf(d - mn);
+                l[h] = l[h] * corr + pe;
+                for (int i = 0; i < 4; ++i) acc[h][i] = acc[h][i] * corr + pe * vf[i];
+                m[h] = mn;
+            }
+        }
+        __syncthreads();
+    }
+    for (int h = 0; h < 4; ++h) {
+        const long long at = ((long long)r * QH + kh * 4 + h) * CH + c;
+        float* pa = pacc + at * HD + lane * 4;
+        for (int i = 0; i < 4; ++i) pa[i] = acc[h][i];
+        if (lane == 0) {
+            pm[at] = m[h];
+            pl[at] = l[h];
+        }
+    }
+}

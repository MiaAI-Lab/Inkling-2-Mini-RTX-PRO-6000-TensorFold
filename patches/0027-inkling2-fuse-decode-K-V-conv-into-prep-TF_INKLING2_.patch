+// Fused decode K/V 4-tap conv + Q/rel/K/V prep in a single launch (TF_INKLING2_DECODE_KV_CONV_PREP).
+// Q/rel warps (y < heads) run per row; K/V warps (y >= heads) walk each stream's segment in order.
+template <bool KV8>
+__device__ __forceinline__ void prepConvRow(const uint16_t* __restrict__ q_raw, const uint16_t* __restrict__ k_raw,
+                                            const uint16_t* __restrict__ v_raw, const uint16_t* __restrict__ rel_raw,
+                                            const uint16_t* __restrict__ q_scale, const uint16_t* __restrict__ rel_scale,
+                                            const int* __restrict__ rpos, const int* __restrict__ rseg,
+                                            const Seg* __restrict__ segs, uint16_t* __restrict__ q_out,
+                                            uint16_t* __restrict__ rel_out, uint16_t* __restrict__ kc,
+                                            uint16_t* __restrict__ vc, int heads, int kv_heads, int ring, int global,
+                                            float qk_clip, float rel_clip, float floor_pos, float alpha, float eps,
+                                            float* __restrict__ ksc, float* __restrict__ vsc,
+                                            const int4* __restrict__ conv_segs, int n_streams,
+                                            float* __restrict__ k_state, float* __restrict__ v_state,
+                                            const uint16_t* __restrict__ k_w, const uint16_t* __restrict__ v_w,
+                                            const float* __restrict__ k_dyn, const float* __restrict__ v_dyn,
+                                            float* __restrict__ k_hist, float* __restrict__ v_hist) {
+    const int y = blockIdx.y, lane = threadIdx.x;
+    if (y < heads) {
+        const int row = blockIdx.x;
+        const int pos = rpos[row];
+        const float tau = global ? 1.0f + alpha * logf(fmaxf(static_cast<float>(pos + 1) / floor_pos, 1.0f)) : 1.0f;
+        float x[4];
+        const uint16_t* src = q_raw + (static_cast<size_t>(row) * heads + y) * kDim;
+        for (int i = 0; i < 4; ++i) x[i] = bf(src[lane * 4 + i]) * bf(q_scale[y * kDim + lane * 4 + i]);
+        clip(x, qk_clip);
+        uint16_t* dst = q_out + (static_cast<size_t>(row) * heads + y) * kDim;
+        for (int i = 0; i < 4; ++i) dst[lane * 4 + i] = global ? tobf(bf(tobf(x[i])) * tau) : tobf(x[i]);
+        float r = lane < kRel ? bf(rel_raw[(static_cast<size_t>(row) * heads + y) * kRel + lane]) *
+                                    bf(rel_scale[y * kRel + lane])
+                              : 0.0f;
+        const float norm = sqrtf(warpSum(r * r));
+        r *= fminf(rel_clip / (norm + 1e-6f), 1.0f);
+        if (lane < kRel) {
+            const uint16_t v = global ? tobf(bf(tobf(r)) * tau) : tobf(r);
+            rel_out[(static_cast<size_t>(row) * heads + y) * kRel + lane] = v;
+        }
+        return;
+    }
+    if (blockIdx.x >= n_streams) return;
+    const bool key = y < heads + kv_heads;
+    const int h = key ? y - heads : y - heads - kv_heads;
+    const int4 sg = conv_segs[blockIdx.x];
+    if (sg.y <= 0) return;
+    const int C = kv_heads * kDim;
+    const int c0 = h * kDim + lane * 4;
+    float* st = (key ? k_state : v_state) + static_cast<size_t>(sg.z) * 3 * C;
+    const uint16_t* w = key ? k_w : v_w;
+    const float* dyn = key ? k_dyn : v_dyn;
+    float* hist = key ? k_hist : v_hist;
+    const uint16_t* raw = key ? k_raw : v_raw;
+    float h0[4], h1[4], h2[4];
+    for (int i = 0; i < 4; ++i) {
+        h0[i] = st[c0 + i];
+        h1[i] = st[C + c0 + i];
+        h2[i] = st[2 * C + c0 + i];
+    }
+    for (int t = sg.x; t < sg.x + sg.y; ++t) {
+        const size_t at0 = static_cast<size_t>(t) * C + c0;
+        float x[4];
+        if (dyn) {
+            const float* d = dyn + (static_cast<size_t>(t) * kv_heads + h) * 4;
+            const float d0 = d[0], d1 = d[1], d2 = d[2], d3 = d[3];
+            for (int i = 0; i < 4; ++i) {
+                const int c = c0 + i;
+                const float xin = bf(raw[at0 + i]);
+                if (hist) hist[at0 + i] = xin;
+                float cy = __fadd_rn(__fmul_rn(__fadd_rn(bf(w[c]), d0), xin),
+                                     __fmul_rn(__fadd_rn(bf(w[C + c]), d1), h2[i]));
+                cy = __fadd_rn(cy, __fmul_rn(__fadd_rn(bf(w[2 * C + c]), d2), h1[i]));
+                cy = __fadd_rn(cy, __fmul_rn(__fadd_rn(bf(w[3 * C + c]), d3), h0[i]));
+                cy = __fdiv_rn(__fadd_rn(cy, xin), 3.0f);
+                x[i] = bf(tobf(cy));
+                h0[i] = h1[i];
+                h1[i] = h2[i];
+                h2[i] = xin;
+            }
+        } else {
+            for (int i = 0; i < 4; ++i) {
+                const uint16_t* wc = w + static_cast<size_t>(c0 + i) * 4;
+                const float xin = bf(raw[at0 + i]);
+                if (hist) hist[at0 + i] = xin;
+                float cy = __fadd_rn(__fmul_rn(bf(wc[0]), h0[i]), __fmul_rn(bf(wc[1]), h1[i]));
+                cy = __fadd_rn(cy, __fmul_rn(bf(wc[2]), h2[i]));
+                cy = __fadd_rn(cy, __fmul_rn(bf(wc[3]), xin));
+                cy = __fdiv_rn(__fadd_rn(cy, xin), 2.2360679774997896f);
+                x[i] = bf(tobf(cy));
+                h0[i] = h1[i];
+                h1[i] = h2[i];
+                h2[i] = xin;
+            }
+        }
+        if (key) {
+            clip(x, qk_clip);
+        } else {
+            const float r = rsqrtf(warpSum(x[0] * x[0] + x[1] * x[1] + x[2] * x[2] + x[3] * x[3]) / kDim + eps);
+            for (int i = 0; i < 4; ++i) x[i] *= r;
+        }
+        const Seg s = segs[rseg[t]];
+        const size_t slot = static_cast<size_t>(h) * ring + rpos[t] % ring;
+        if constexpr (KV8) {
+            float amax = 0.0f;
+            for (int i = 0; i < 4; ++i) {
+                x[i] = bf(tobf(x[i]));
+                amax = fmaxf(amax, fabsf(x[i]));
+            }
+            amax = warpMax(amax);
+            const float sc = amax > 0.0f ? amax / 448.0f : 1.0f;
+            uint32_t word = 0;
+            for (int i = 0; i < 4; ++i) {
+                const __nv_fp8_e4m3 c(x[i] / sc);
+                word |= static_cast<uint32_t>(c.__x) << (8 * i);
+            }
+            uint8_t* dst = reinterpret_cast<uint8_t*>(key ? kc : vc) + s.off + slot * kDim;
+            reinterpret_cast<uint32_t*>(dst)[lane] = word;
+            if (lane == 0) (key ? ksc : vsc)[s.off / kDim + slot] = sc;
+        } else {
+            uint16_t* dst = (key ? kc : vc) + s.off + slot * kDim;
+            for (int i = 0; i < 4; ++i) dst[lane * 4 + i] = tobf(x[i]);
+        }
+    }
+    for (int i = 0; i < 4; ++i) {
+        st[c0 + i] = h0[i];
+        st[C + c0 + i] = h1[i];
+        st[2 * C + c0 + i] = h2[i];
+    }
+}
+
 }  // namespace ink2
 
 using ink2::Seg;
@@ -149,6 +277,11 @@ using ink2::Seg;
 #define TF_INK2_PREP_PASS                                                                                          \
     q_raw, k_raw, v_raw, rel_raw, q_scale, rel_scale, rpos, rseg, segs, q_out, rel_out, kc, vc, heads, kv_heads,   \
         ring, global, qk_clip, rel_clip, floor_pos, alpha, eps

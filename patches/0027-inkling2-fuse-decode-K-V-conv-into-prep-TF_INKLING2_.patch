index 086020f02..e15b3ce9a 100644
--- a/zig/kernels/cuda/inkling2/attention.cu
+++ b/zig/kernels/cuda/inkling2/attention.cu
@@ -135,6 +135,134 @@ __device__ __forceinline__ void prepRow(const uint16_t* __restrict__ q_raw, cons

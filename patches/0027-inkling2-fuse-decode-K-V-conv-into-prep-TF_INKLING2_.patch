             .prep = try mod.function("tf_ink2_prep"),
@@ -224,6 +228,39 @@ pub fn prep(k: *const Kernels, s: cuda.Stream, r: Rows, l: Layer, c: Prep, raw:
     try go(if (kv.fp8()) k.prep8 else k.prep, s, .{ .x = r.rows, .y = r.heads + 2 * r.kv_heads }, 32, &a);
 }
 
+/// Fused decode K/V conv + Q/rel/K/V prep in one launch (TF_INKLING2_DECODE_KV_CONV_PREP).
+pub const ConvPrep = struct {
+    conv_segs: u64,
+    n_streams: u32,
+    k_state: u64,
+    v_state: u64,
+    k_w: u64,
+    v_w: u64,
+    k_dyn: u64,
+    v_dyn: u64,
+    k_hist: u64,
+    v_hist: u64,
+};
+
+pub fn prepConv(k: *const Kernels, s: cuda.Stream, r: Rows, l: Layer, c: Prep, raw: [4]u64, scales: [2]u64, q: u64, rel: u64, kv: Cache, cp: ConvPrep) !void {
+    try headsFit(r);
+    var a: cuda.Args = .{};
+    for (raw ++ scales ++ [_]u64{ r.pos, r.seg_of, r.segs, q, rel, kv.k, kv.v }) |v| a.add(v);
+    a.add(int(r.heads));
+    a.add(int(r.kv_heads));
+    a.add(int(l.ring));
+    a.add(int(@intFromBool(l.tau)));
+    for ([_]f32{ c.qk_clip, c.rel_clip, c.floor, c.alpha, c.eps }) |v| a.add(v);
+    if (kv.fp8()) {
+        a.add(kv.ks);
+        a.add(kv.vs);
+    }
+    a.add(cp.conv_segs);
+    a.add(int(cp.n_streams));
+    for ([_]u64{ cp.k_state, cp.v_state, cp.k_w, cp.v_w, cp.k_dyn, cp.v_dyn, cp.k_hist, cp.v_hist }) |v| a.add(v);
+    try go(if (kv.fp8()) k.prep_conv8 else k.prep_conv, s, .{ .x = @max(r.rows, cp.n_streams), .y = r.heads + 2 * r.kv_heads }, 32, &a);
+}
+
 /// K and V only (written to caches at pos % ring); skips Q and rel when last-visit outputs are unread.
 pub fn prepKvOnly(k: *const Kernels, s: cuda.Stream, r: Rows, l: Layer, c: Prep, k_raw: u64, v_raw: u64, kv: Cache) !void {
     try headsFit(r);
diff --git a/zig/src/families/inkling2/mini_visit.zig b/zig/src/families/inkling2/mini_visit.zig
index d66ef68ad..daa90426b 100644
--- a/zig/src/families/inkling2/mini_visit.zig
+++ b/zig/src/families/inkling2/mini_visit.zig
@@ -130,6 +130,15 @@ fn proj(m: *const Model, k: *const Kernels, s: cuda.Stream, w: cuda.qmmf.Weight,
     try k.lane.matmulOut(s, x, w.k, n, w, out, .bf16, m.s.lane_part);
 }
 
+/// TF_INKLING2_DECODE_KV_CONV_PREP=0: disable fused decode K/V conv + prep kernel.
+fn decodeKvConvPrepOn() bool {
+    const S = struct {
+        var v: ?bool = null;
+    };
+    if (S.v == null) S.v = if (std.c.getenv("TF_INKLING2_DECODE_KV_CONV_PREP")) |e| e[0] != '0' else true;
+    return S.v.?;
+}
+
 /// TF_INKLING2_ATTN_FP8_TC=1 (P3, lossy, default off): FP8 tensor-core attention projections for prompt rows.
 fn attnFp8TcOn() bool {
     const S = struct {
@@ -401,15 +410,30 @@ fn visitOne(m: *Model, k: *const Kernels, s: cuda.Stream, r: *const Rows, v: u32
         // the taps as torch's bf16 linear leaves them: float(bf16(sum)) times 1
         try k.dense.rowsScaled(s, x, h, w, m.w.ones, m.s.dyn[side], taps, n, taps, h);
     };
-    for ([_]Site{ .k, .v }, [_]u64{ o.k, o.v }, [_]u64{ m.s.kc, m.s.vc }, [_]u64{ a.k_conv, a.v_conv }, 0..) |site, x, out, w, side| {
-        try conv(m, k, s, r, v, site, .{ .x = x, .state = 0, .w = w, .dyn = if (global) m.s.dyn[side] else 0, .out = out, .x_bf16 = 1, .heads = @intCast(kvh), .c = @intCast(kvw), .rows = 0, .mode = 0 });
-    }
     // q, rel and the caches' new K and V rows, the bias table, then attention through the sink and the output gate
     const l = if (global) m.full else m.sliding;
     const rows: attn.Rows = .{ .rows = @intCast(n), .heads = t.local.q, .kv_heads = t.local.kv, .pos = m.s.pos, .seg_of = m.s.seg_of, .segs = m.s.segs[@intFromBool(global)], .tiles = m.s.tiles, .n_tiles = r.n_tiles, .last_pos = r.last_pos, .streams = @intCast(r.streams) };
     const cache: attn.Cache = .{ .k = m.kv[0][v], .v = m.kv[1][v], .ks = m.kvs[0][v], .vs = m.kvs[1][v] };
     const prep: attn.Prep = .{ .qk_clip = t.qk_clip, .rel_clip = t.rel_clip, .floor = @floatFromInt(t.log_floor), .alpha = t.log_alpha, .eps = t.eps };
-    try attn.prep(&k.attn, s, rows, l, prep, .{ o.q, m.s.kc, m.s.vc, o.rel }, .{ a.q_scale, a.rel_scale }, m.s.qp, m.s.relp, cache);
+    if (!r.prompt and decodeKvConvPrepOn()) {
+        try attn.prepConv(&k.attn, s, rows, l, prep, .{ o.q, o.k, o.v, o.rel }, .{ a.q_scale, a.rel_scale }, m.s.qp, m.s.relp, cache, .{
+            .conv_segs = m.s.conv_segs,
+            .n_streams = @intCast(r.streams),
+            .k_state = m.conv[v][@intFromEnum(Site.k)],
+            .v_state = m.conv[v][@intFromEnum(Site.v)],
+            .k_w = a.k_conv,
+            .v_w = a.v_conv,
+            .k_dyn = if (global) m.s.dyn[0] else 0,
+            .v_dyn = if (global) m.s.dyn[1] else 0,
+            .k_hist = if (m.hist_on) m.hist[v][@intFromEnum(Site.k)] else 0,
+            .v_hist = if (m.hist_on) m.hist[v][@intFromEnum(Site.v)] else 0,
+        });
+    } else {
+        for ([_]Site{ .k, .v }, [_]u64{ o.k, o.v }, [_]u64{ m.s.kc, m.s.vc }, [_]u64{ a.k_conv, a.v_conv }, 0..) |site, x, out, w, side| {
+            try conv(m, k, s, r, v, site, .{ .x = x, .state = 0, .w = w, .dyn = if (global) m.s.dyn[side] else 0, .out = out, .x_bf16 = 1, .heads = @intCast(kvh), .c = @intCast(kvw), .rows = 0, .mode = 0 });
+        }
+        try attn.prep(&k.attn, s, rows, l, prep, .{ o.q, m.s.kc, m.s.vc, o.rel }, .{ a.q_scale, a.rel_scale }, m.s.qp, m.s.relp, cache);
+    }
     try attn.relTable(&k.attn, s, rows, m.s.relp, a.rel_proj, m.s.tab);
     const stride = attn.slotsFor(l, m.context);
     try attn.attend(&k.attn, s, rows, l, stride, m.s.entries, m.s.qp, cache, m.s.tab, m.s.part_o, m.s.part_ml, o.sink, o.gate, m.s.att);

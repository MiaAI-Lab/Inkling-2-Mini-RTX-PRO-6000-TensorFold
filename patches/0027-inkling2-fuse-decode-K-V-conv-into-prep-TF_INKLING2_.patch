+    const int4 *__restrict__ conv_segs, int n_streams, float *__restrict__ k_state, float *__restrict__ v_state,   \
+        const uint16_t *__restrict__ k_w, const uint16_t *__restrict__ v_w, const float *__restrict__ k_dyn,       \
+        const float *__restrict__ v_dyn, float *__restrict__ k_hist, float *__restrict__ v_hist
+#define TF_INK2_CONV_PASS conv_segs, n_streams, k_state, v_state, k_w, v_w, k_dyn, v_dyn, k_hist, v_hist
 
 extern "C" __global__ void tf_ink2_prep(TF_INK2_PREP_ARGS) {
     ink2::prepRow<false>(TF_INK2_PREP_PASS, nullptr, nullptr);
@@ -159,6 +292,15 @@ extern "C" __global__ void tf_ink2_prep8(TF_INK2_PREP_ARGS, float* __restrict__
     ink2::prepRow<true>(TF_INK2_PREP_PASS, ksc, vsc);
 }
 
+extern "C" __global__ void tf_ink2_prep_conv(TF_INK2_PREP_ARGS, TF_INK2_CONV_ARGS) {
+    ink2::prepConvRow<false>(TF_INK2_PREP_PASS, nullptr, nullptr, TF_INK2_CONV_PASS);
+}
+
+extern "C" __global__ void tf_ink2_prep_conv8(TF_INK2_PREP_ARGS, float* __restrict__ ksc, float* __restrict__ vsc,
+                                              TF_INK2_CONV_ARGS) {
+    ink2::prepConvRow<true>(TF_INK2_PREP_PASS, ksc, vsc, TF_INK2_CONV_PASS);
+}
